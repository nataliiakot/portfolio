---
import { profile, contactFaq } from '../content/site';
interface Props { showFaq?: boolean; }
const { showFaq = true } = Astro.props;
---
<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="contact-copy"><h2 id="contact-title"><span>Have a product challenge, a project idea, or a role in mind? Let’s talk</span></h2>
  <div class="actions contact-actions"><a class="button primary" href={profile.cvPath} target="_blank" rel="noopener noreferrer">CV<span class="sr-only"> (opens in a new tab)</span></a><a class="button" href={profile.telegram} target="_blank" rel="noopener noreferrer" data-cursor="Telegram" data-cursor-color="#ccecff">Telegram<span class="sr-only"> (opens in a new tab)</span></a></div>
  </div>{showFaq && <div class="contact-faq">
    {contactFaq.map(item => <details name="contact-faq"><summary>{item.question}</summary><p>{item.answer}</p></details>)}
  </div>}
</section>

<script>
  const faq = document.querySelector<HTMLElement>('.contact-faq');
  if (faq) {
    const items = [...faq.querySelectorAll('details')];
    items.forEach(item => item.addEventListener('toggle', () => {
      if (item.open) items.forEach(other => { if (other !== item) other.open = false; });
    }));
    let frame = 0;
    let lastWidth = 0;
    function reserveAnswerSpace() {
      if (!faq) return;
      const clone = faq.cloneNode(true) as HTMLElement;
      clone.setAttribute('aria-hidden', 'true');
      clone.inert = true;
      Object.assign(clone.style, {
        position: 'absolute', visibility: 'hidden', pointerEvents: 'none',
        width: `${faq.getBoundingClientRect().width}px`, height: 'auto',
        minHeight: '0', top: '0', left: '0',
      });
      const copies = [...clone.querySelectorAll('details')];
      copies.forEach(item => { item.removeAttribute('name'); item.open = false; });
      faq.parentElement?.append(clone);
      let height = clone.getBoundingClientRect().height;
      copies.forEach(item => {
        item.open = true;
        height = Math.max(height, clone.getBoundingClientRect().height);
        item.open = false;
      });
      clone.remove();
      faq.style.minHeight = `${Math.ceil(height)}px`;
    }
    function scheduleMeasurement() {
      cancelAnimationFrame(frame);
      frame = requestAnimationFrame(reserveAnswerSpace);
    }
    new ResizeObserver(() => {
      const width = faq.getBoundingClientRect().width;
      if (width !== lastWidth) { lastWidth = width; scheduleMeasurement(); }
    }).observe(faq);
    document.addEventListener('portfolio:language-change', scheduleMeasurement);
    document.fonts.ready.then(scheduleMeasurement);
    scheduleMeasurement();
  }
</script>
