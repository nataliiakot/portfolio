---
import Arrow from './Arrow.astro';
import { profile } from '../content/site';
import { recommendations } from '../content/recommendations';
---
{recommendations.length > 0 && <section class="recommendations section-shell" aria-labelledby="recommendations-title">
  <h2 id="recommendations-title">Recommendations</h2>
  <div class="recommendation-grid">
    {recommendations.map(item => <a class="recommendation-card" href={profile.linkedinRecommendations} target="_blank" rel="noopener noreferrer">
      <figure>
        <div class="recommendation-source"><span class="recommendation-linkedin" aria-hidden="true">in</span><span>LinkedIn recommendation</span></div>
        <blockquote lang="en">{item.quote.split('\n\n').map((paragraph, index, paragraphs) => <p>{index === 0 && '“'}{paragraph}{index === paragraphs.length - 1 && '”'}</p>)}</blockquote>
        <figcaption><span class="recommendation-read">Read on LinkedIn <Arrow /></span></figcaption>
      </figure>
      <span class="sr-only"> (opens in a new tab)</span>
    </a>)}
  </div>
</section>}

<style lang="scss">
  .recommendations { padding-bottom: var(--section-space); }
  h2 { margin: 0 0 32px; font-size: clamp(32px, 3.5vw, 48px); font-weight: 700; line-height: 1.15; letter-spacing: -.03em; }
  .recommendation-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .recommendation-card { display: block; padding: 28px; border: 1px solid #dce2e8; border-radius: 24px; color: #17242b; text-decoration: none; background: linear-gradient(135deg, #fff, #f3f8ff); box-shadow: inset 0 1px 0 #fff, 0 8px 24px #182b4508; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .recommendation-card:last-child:nth-child(odd) { grid-column: 1 / -1; }
  figure { display: flex; flex-direction: column; height: 100%; gap: 20px; margin: 0; }
  .recommendation-source { display: flex; align-items: center; gap: 10px; color: #52606c; font-size: 14px; line-height: 1.5; }
  .recommendation-linkedin { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 5px; background: #0a66c2; color: #fff; font-size: 22px; line-height: 1; font-weight: 750; letter-spacing: -.04em; }
  blockquote { flex: 1; margin: 0; }
  blockquote p { max-width: 80ch; margin: 0; font-size: 17px; line-height: 1.65; letter-spacing: 0; font-weight: 400; text-wrap: pretty; }
  blockquote p + p { margin-top: 12px; }
  figcaption { width: 100%; max-width: none; margin: 0; display: flex; align-items: center; justify-content: flex-end; gap: 20px; }
  .recommendation-read { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; line-height: 1.5; color: #0a66c2; font-weight: 600; }
  .recommendation-card:focus-visible { outline: 3px solid #2454e6; outline-offset: 4px; }
  @media (hover: hover) { .recommendation-card:hover { transform: translateY(-3px); border-color: #8bbbe7; box-shadow: 0 12px 28px #182b4510; } }
  @media (max-width: 720px) {
    .recommendation-grid { grid-template-columns: minmax(0, 1fr); }
    h2 { margin-bottom: 24px; }
    .recommendation-card { border-radius: 20px; padding: 24px; }
    figure { gap: 20px; }
    figcaption { align-items: flex-start; flex-direction: column; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .recommendation-card { transition: none; }.recommendation-card:hover { transform: none; } }
</style>
