---
import Arrow from './Arrow.astro';
import { profile } from '../content/site';
import { recommendations } from '../content/recommendations';
---
{recommendations.length > 0 && <section id="recommendations" class="recommendations" aria-labelledby="recommendations-title">
  <div class="recommendation-heading section-shell">
    <h2 id="recommendations-title">Recommendations</h2>
  </div>
  <div id="recommendations-carousel" class="recommendation-carousel" tabindex="0" role="region" aria-label="LinkedIn recommendations">
  <div class="recommendation-track">
    {recommendations.map(item => <button type="button" class="recommendation-card" aria-haspopup="dialog" aria-controls="recommendation-dialog">
      <span class="recommendation-content">
        <span class="recommendation-source"><span class="recommendation-linkedin" aria-hidden="true">in</span><span>LinkedIn recommendation</span></span>
        <span class="recommendation-quote" lang="en">{item.quote.split('\n\n').map((paragraph, index, paragraphs) => <span class="recommendation-paragraph">{index === 0 && '“'}{paragraph}{index === paragraphs.length - 1 && '”'}</span>)}</span>
        <span class="recommendation-read">Read full recommendation <Arrow /></span>
      </span>
    </button>)}
  </div>
  </div>
</section>}
<dialog id="recommendation-dialog" class="recommendation-dialog" aria-labelledby="recommendation-dialog-title">
  <div class="recommendation-dialog-heading"><h2 id="recommendation-dialog-title">LinkedIn recommendation</h2><button type="button" class="recommendation-close" aria-label="Close recommendation" autofocus>✕</button></div>
  <blockquote class="recommendation-full-quote" lang="en"></blockquote>
  <a class="recommendation-read" href={profile.linkedinRecommendations} target="_blank" rel="noopener noreferrer">Read on LinkedIn <Arrow /><span class="sr-only"> (opens in a new tab)</span></a>
</dialog>

<style lang="scss">
  .recommendations { padding-bottom: var(--home-section-gap, var(--section-space)); }
  h2 { margin: 0; font-size: clamp(32px, 3.5vw, 48px); font-weight: 700; line-height: 1.15; letter-spacing: -.03em; }
  .recommendation-heading { display: flex; align-items: center; justify-content: space-between; gap: 20px; margin-bottom: 24px; }
  .recommendation-carousel { position: relative; --card-width: min(560px, calc(100vw - var(--page-gutter) * 2 - 16px)); overflow-x: auto; overscroll-behavior-inline: contain; scroll-behavior: auto; overflow-anchor: none; scrollbar-width: thin; scrollbar-color: #c6d6e3 transparent; padding-block: 4px 12px; }
  .recommendation-carousel:focus-visible { outline: 3px solid #2454e6; outline-offset: 4px; border-radius: 24px; }
  .recommendation-track { display: flex; width: max-content; align-items: flex-start; gap: 16px; }
  .recommendation-card { display: block; flex: 0 0 var(--card-width); width: var(--card-width); padding: 20px; border: 1px solid #dce2e8; border-radius: 24px; color: #17242b; font: inherit; text-align: left; cursor: pointer; background: linear-gradient(135deg, #fff, #f3f8ff); box-shadow: inset 0 1px 0 #fff, 0 8px 24px #182b4508; transition: transform .2s, border-color .2s, box-shadow .2s; }
  .recommendation-content { display: flex; flex-direction: column; gap: 14px; margin: 0; }
  .recommendation-source { display: flex; align-items: center; gap: 10px; color: #52606c; font-size: 14px; line-height: 1.5; }
  .recommendation-linkedin { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 5px; background: #0a66c2; color: #fff; font-size: 22px; line-height: 1; font-weight: 750; letter-spacing: -.04em; }
  .recommendation-quote { display: block; height: var(--recommendation-preview-height, 140px); overflow: hidden; }
  .recommendation-quote.is-truncated { mask-image: linear-gradient(#000 calc(100% - 20px), transparent); }
  .recommendation-paragraph { display: block; max-width: 80ch; margin: 0; font-size: 17px; line-height: 1.65; letter-spacing: 0; font-weight: 400; text-wrap: pretty; }
  .recommendation-paragraph + .recommendation-paragraph { margin-top: 8px; }

  .recommendation-read { align-self: flex-end; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; line-height: 1.5; color: #0a66c2; font-weight: 600; }
  .recommendation-card:focus-visible { outline: 3px solid #2454e6; outline-offset: -4px; }
  @media (hover: hover) { .recommendation-card:hover { transform: translateY(-3px); border-color: #8bbbe7; box-shadow: 0 12px 28px #182b4510; } }
  @media (max-width: 720px) {
    .recommendation-heading { gap: 12px; flex-wrap: wrap; }
    h2 { font-size: clamp(28px, 7vw, 32px); }
    .recommendation-card { border-radius: 20px; padding: 18px; }
    .recommendation-content { gap: 14px; }
    .recommendation-read { align-self: flex-start; }
  }
  .recommendation-dialog { width: min(640px, calc(100% - 32px)); max-height: calc(100dvh - 48px); padding: 24px; border: 1px solid #dce2e8; border-radius: 24px; background: #fff; color: #17242b; overscroll-behavior: contain; }
  .recommendation-dialog::backdrop { background: #17242b80; }
  .recommendation-dialog-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
  .recommendation-dialog-heading h2 { font-size: 22px; line-height: 1.4; letter-spacing: -.02em; }
  .recommendation-close { flex-shrink: 0; width: 44px; height: 44px; border: 1px solid #dce2e8; border-radius: 50%; background: #f7f9fc; color: #17242b; font-size: 20px; cursor: pointer; }
  .recommendation-close:focus-visible, .recommendation-dialog a:focus-visible { outline: 3px solid #2454e6; outline-offset: 3px; }
  .recommendation-full-quote { margin: 0 0 24px; font-size: 17px; line-height: 1.65; }
  .recommendation-full-quote :global(p) { margin: 0; }
  .recommendation-full-quote :global(p + p) { margin-top: 12px; }
  :global(html:has(.recommendation-dialog[open])) { overflow: hidden; }
  :global(html:has(.recommendation-dialog[open]) .context-cursor) { display: none; }
  .recommendation-dialog, .recommendation-dialog :global(*) { cursor: auto !important; }
  .recommendation-dialog button, .recommendation-dialog a { cursor: pointer !important; }
  @media (prefers-reduced-motion: reduce) { .recommendation-card { transition: none; }.recommendation-card:hover { transform: none; } }
</style>

<script>
  import { initRecommendationsCarousel } from '../scripts/recommendations-carousel';
  initRecommendationsCarousel();
</script>
