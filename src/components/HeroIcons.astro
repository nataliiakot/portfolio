---
import { Image } from 'astro:assets';
import figma from '../assets/hero-icons/figma.png';
import photoshop from '../assets/hero-icons/photoshop.png';
import chatgpt from '../assets/hero-icons/chatgpt.png';
import claude from '../assets/hero-icons/claude.png';
import codex from '../assets/hero-icons/codex.png';
const icons = [{ name: 'figma', src: figma }, { name: 'photoshop', src: photoshop }, { name: 'chatgpt', src: chatgpt }, { name: 'claude', src: claude }, { name: 'codex', src: codex }];
---
<div class="hero-icons" aria-hidden="true">
  {icons.map((icon, index) => <span class:list={['hero-app-icon', `hero-app-${icon.name}`]} style={`--float-delay: ${index * -.9}s`}><Image src={icon.src} alt="" widths={[128, 256, 384]} sizes="(max-width: 720px) 100px, (max-width: 1100px) 128px, 176px" format="webp" quality={90} loading="eager" decoding="async" /></span>)}
</div>
<style lang="scss">
  .hero-icons { position: absolute; inset: 0; pointer-events: none; z-index: -1; }
  .hero-app-icon {
    position: absolute; width: clamp(128px, 12vw, 176px); aspect-ratio: 1;
    animation: hero-icon-float 5.5s ease-in-out infinite; animation-delay: var(--float-delay);
    img { display: block; width: 100%; height: 100%; object-fit: contain; }
  }
  .hero-app-claude { top: 13%; left: 6%; }
  .hero-app-photoshop { top: 13%; right: 6%; }
  .hero-app-figma { bottom: 11%; left: 10%; }
  .hero-app-codex { bottom: 11%; right: 10%; }
  .hero-app-chatgpt { bottom: 1%; left: calc(50% - 72px); width: 144px; }
  @keyframes hero-icon-float {
    0%, 100% { transform: translateY(0) rotate(-3deg); }
    50% { transform: translateY(-14px) rotate(3deg); }
  }
  @media (max-width: 1100px) {
    .hero-app-icon { width: 128px; }
    .hero-app-claude { top: 18%; left: 4%; }
    .hero-app-photoshop { top: 18%; right: 4%; }
    .hero-app-figma { bottom: 12%; left: 6%; }
    .hero-app-codex { bottom: 12%; right: 6%; }
    .hero-app-chatgpt { bottom: 2%; left: calc(50% - 64px); }
  }
  @media (max-width: 720px) {
    .hero-app-icon { width: 100px; }
    .hero-app-claude { top: 145px; left: 7%; }
    .hero-app-photoshop { top: 145px; right: 7%; }
    .hero-app-figma { bottom: 75px; left: 3%; }
    .hero-app-codex { bottom: 75px; right: 3%; }
    .hero-app-chatgpt { bottom: 35px; left: calc(50% - 50px); }
  }
  @media (prefers-reduced-motion: reduce) { .hero-app-icon { animation: none; } }
</style>
