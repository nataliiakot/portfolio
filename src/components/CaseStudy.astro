---
import type { Project } from '../content/projects';
import Arrow from './Arrow.astro';
import ImageLightbox from './ImageLightbox.astro';
import ProjectCover from './ProjectCover.astro';
import CaseNarrative from './CaseNarrative.astro';
import CaseHighlights from './CaseHighlights.astro';
import { caseHighlights } from '../content/case-highlights';
interface Props { project: Project; previous?: Project; next?: Project; }
const { project, previous, next } = Astro.props;
const highlights = caseHighlights[project.slug];
const facts = [['Role', project.role], ['Business domain', project.category]].filter(([, value]) => value);
---
<article class:list={['case-study', 'section-shell', `case-${project.slug}`]}>
  <a class="text-link all-work" href="/#work"><span class="reverse-arrow"><Arrow /></span>All work</a>
  <header class="case-heading"><h1><span>{project.title}</span></h1>{project.headline && <p class="case-intro">{project.headline}</p>}{!project.story?.length && <p class="case-summary">{project.summary}</p>}</header>
  {highlights ? <CaseHighlights highlights={highlights} facts={facts} /> : <dl class="case-facts">{facts.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>}
  {project.story?.length ? <CaseNarrative blocks={project.story} /> : <Fragment>
  <ProjectCover project={project} />
  {project.context?.length && <section class="case-section"><h2>The challenge</h2><div>{project.context.map(paragraph => <p>{paragraph}</p>)}</div></section>}
  {project.solution?.length && <section class="case-section"><h2>The solution</h2><div>{project.solution.map(paragraph => <p>{paragraph}</p>)}</div></section>}
  {project.approach?.length && <section class="case-section"><h2>Responsibilities</h2><ul class="case-responsibilities">{project.approach.map(item => <li>{item}</li>)}</ul></section>}
  {project.features?.length && <section class="case-section"><h2>Core features</h2><ul class="case-responsibilities">{project.features.map(item => <li>{item}</li>)}</ul></section>}
  {project.visuals?.length && <section aria-label="Project visuals" class="case-visuals">{project.visuals.map(image => <figure><img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" /></figure>)}</section>}
  {project.results?.length && <section class="case-section case-impact"><h2>Achievements</h2><div>{project.results.map(paragraph => <p>{paragraph}</p>)}</div></section>}
  </Fragment>}
  {(previous || next) && <nav class="case-project-nav" aria-label="Case study navigation">
    {previous && <a class="case-project-link previous" href={`/projects/${previous.slug}/`} rel="prev"><span class="case-project-direction">Previous project</span><span class="case-project-title"><span class="reverse-arrow"><Arrow /></span>{previous.title}</span></a>}
    {next && <a class="case-project-link next" href={`/projects/${next.slug}/`} rel="next"><span class="case-project-direction">Next project</span><span class="case-project-title">{next.title}<Arrow /></span></a>}
  </nav>}
</article>
<ImageLightbox />

<style lang="scss">
  .case-project-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; border-top: 1px solid var(--line); padding-top: 24px; }
  .case-project-link { display: flex; flex-direction: column; justify-content: center; gap: 12px; min-width: 0; min-height: 104px; padding: 16px; border-radius: 12px; text-decoration: none; color: inherit; transition: background .2s; }
  .case-project-link:hover, .case-project-link:focus-visible { background: #f5f8fb; }
  .case-project-direction { font-size: 13px; line-height: 1.5; color: var(--muted); }
  .case-project-title { display: flex; align-items: center; gap: 12px; font-size: clamp(20px, 3vw, 32px); font-weight: 600; line-height: 1.3; letter-spacing: -.025em; }
  .case-project-title :global(svg) { flex-shrink: 0; }
  .case-project-link.next { grid-column: 2; align-items: flex-end; text-align: right; }
  @media (max-width: 600px) {
    .case-project-nav { gap: 12px; padding-top: 16px; }
    .case-project-link { padding: 12px 0; gap: 8px; }
    .case-project-title { gap: 8px; }
    .case-project-direction { font-size: 12px; }
  }
  @media (prefers-reduced-motion: reduce) { .case-project-link { transition: none; } }
</style>
