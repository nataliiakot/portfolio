---
import type { Project } from '../content/projects';
interface Props { project: Project; }
const { project } = Astro.props;
---
<div class:list={['project-stage', `project-stage-${project.slug}`]} aria-hidden="true"><span class="project-stage-domain">{project.category}</span><span class="project-stage-title">{project.title}</span>{project.cover && <img class="project-stage-thumbnail" src={project.cover.src} alt="" width={project.cover.width} height={project.cover.height} loading="lazy" />}<span class="project-stage-type">{project.slug === 'cleanly' || project.slug === 'nova-bank' ? 'Mobile app' : 'Web platform'}</span></div>
