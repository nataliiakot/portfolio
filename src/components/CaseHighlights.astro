---
import { caseText } from '../utils/case-typography';
import type { CaseHighlights } from '../content/case-highlights';
interface Props { highlights: CaseHighlights; facts: (string | undefined)[][]; }
const { highlights, facts } = Astro.props;
---
<section class="case-highlights" aria-label="Project highlights">
  <dl class="case-facts" aria-label="Project details">
    {facts.map(([label, value]) => <div><dt>{caseText(label)}</dt><dd>{caseText(value)}</dd></div>)}
  </dl>
  <dl class:list={['case-highlight-metrics', { 'has-three': highlights.metrics.length === 3 }]}>
    {highlights.metrics.map(metric => <div class="case-highlight-metric">
      <dt>{caseText(metric.label)}</dt>
      <dd><strong>{metric.value}</strong>{metric.note && <p>{caseText(metric.note)}</p>}</dd>
    </div>)}
  </dl>
</section>

<style lang="scss">
  .case-highlights { margin-block: 24px 32px; display: grid; gap: 24px; }
  .case-highlight-metrics { display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 16px; margin: 0; padding: 0; }
  .case-highlight-metric { display: flex; flex-direction: column; min-width: 0; padding: 24px; border: 1px solid #dce2e8; border-radius: 24px; background: #f7f9fc; }
  .case-highlight-metric dt { display: flex; flex-direction: column; gap: 6px; font-size: 16px; line-height: 1.5; font-weight: 400; color: #414c55; }
  .case-highlight-metric dd { margin: 12px 0 0; }
  .case-highlight-metric strong { display: block; font-size: 42px; line-height: 1.1; letter-spacing: -.035em; font-weight: 700; color: #17242b; }
  .case-highlight-metric p { font-size: 16px; line-height: 1.5; font-weight: 400; margin: 8px 0 0; color: #414c55; }
  .case-highlights .case-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; margin: 0; padding: 0; border: 0; border-radius: 0; background: transparent; }
  .case-highlights .case-facts > div { min-width: 0; padding: 14px 24px; border: 1px solid color-mix(in srgb, var(--tag-ink) 14%, transparent); border-radius: 999px; background: color-mix(in srgb, var(--tag-bg) 80%, white 20%); box-shadow: inset 0 1px 0 #ffffffb3; }
  .case-highlights .case-facts dt { font-size: 14px; line-height: 1.5; font-weight: 600; color: var(--tag-ink); }
  .case-highlights .case-facts dd { font-size: 16px; line-height: 1.5; font-weight: 400; color: var(--tag-ink); margin-top: 4px; }
  @media (max-width: 800px) {
    .case-highlights .case-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .case-facts > div:nth-child(3) { grid-column: 1 / -1; }
  }
  @media (max-width: 720px) {
    .case-highlights { margin-block: 16px 24px; gap: 24px; }
    .case-highlight-metrics { gap: 12px; }
    .case-highlight-metric { padding: 16px; border-radius: 18px; }
    .case-highlight-metric strong { font-size: 32px; }
    .has-three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .has-three > :last-child { grid-column: 1 / -1; }
    .case-highlights .case-facts { padding: 0; }
    .case-highlights .case-facts > div { padding: 12px 20px; }
  }
  @media (max-width: 540px) {
    .case-highlight-metrics, .has-three, .case-highlights .case-facts { grid-template-columns: minmax(0, 1fr); }
  }
</style>
