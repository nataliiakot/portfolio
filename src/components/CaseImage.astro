---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props {
  src: ImageMetadata;
  alt: string;
  widths: number[];
  sizes: string;
  format?: 'webp';
  quality?: number;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'auto';
}
const { src, alt, ...props } = Astro.props;
const full = await getImage({ src, format: 'webp', quality: 90 });
---
<a class="case-image-link" href={full.src} data-case-image aria-label="Open image full screen">
  <Image src={src} alt={alt} {...props} />
</a>
<style>
  .case-image-link { display: block; cursor: zoom-in; }
  .case-image-link:focus-visible { outline: 3px solid #1758ff; outline-offset: 5px; border-radius: 4px; }
</style>
