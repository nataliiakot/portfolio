---
import { Image } from 'astro:assets';
import landscape from '../../assets/landscape.png';
import Layout from '../../layouts/Layout.astro';
import CaseStudy from '../../components/CaseStudy.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
import { published } from '../../content/projects';
import type { Project } from '../../content/projects';
export function getStaticPaths() {
  return published.map((project, index) => ({ params: { slug: project.slug }, props: { project, next: published.length > 1 ? published[(index + 1) % published.length] : undefined } }));
}
interface Props { project: Project; next?: Project; }
const { project, next } = Astro.props;
---
<Layout title={`${project.title} — Nataliia Kot`} description={project.summary}><CaseStudy project={project} next={next} />
  <div slot="closing" class="closing-scene case-closing">
    <Image class="closing-background" src={landscape} alt="" widths={[768, 1440, 2160]} sizes="100vw" format="webp" loading="lazy" />
    <div class="closing-panel section-shell">
      <Contact showFaq={false} />
      <Footer embedded />
    </div>
  </div>
</Layout>

<style lang="scss">
  .case-closing :global(.contact) { grid-template-columns: minmax(0, 1fr); }
  .case-closing :global(.contact-copy) { max-width: 760px; }
</style>
